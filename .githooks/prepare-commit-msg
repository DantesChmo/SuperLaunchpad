#!/usr/bin/env bash
# Interactive Conventional Commits wizard.
#
# Triggered on `git commit -m "<subject>"`. Asks for a commit type via a
# small arrow-key TUI and prepends `<type>: ` to the subject. Skipped for
# merge/squash/amend/template commits, for messages that already match the
# Conventional Commits format, and when stdin is not attached to a terminal
# (GUI clients, CI).

set -u

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

case "$COMMIT_SOURCE" in
    merge|squash|commit|template) exit 0 ;;
esac

CONVENTIONAL_RE='^(feat|fix|infra|refactor|perf|test|docs|build|ci|chore|style|revert)(\([a-z0-9_/-]+\))?!?: .+'

subject=$(grep -v '^#' "$COMMIT_MSG_FILE" | sed '/^[[:space:]]*$/d' | head -n1)

[[ "$subject" =~ $CONVENTIONAL_RE ]] && exit 0
[ -z "$subject" ] && exit 0

{ exec < /dev/tty; } 2>/dev/null || exit 0

TYPES=(
    "feat       new feature"
    "fix        bug fix"
    "infra      infrastructure, scripts, tooling"
    "refactor   refactor without behaviour change"
    "perf       performance optimisation"
    "test       tests only"
    "docs       documentation"
    "build      build system, dependencies, Package.swift"
    "ci         CI/CD pipelines"
    "chore      routine maintenance"
    "style      formatting, no logic change"
    "revert     revert a previous commit"
)

select_type() {
    local options=("$@")
    local count=${#options[@]}
    local selected=0
    local key key2 i

    tput civis >&2
    trap 'tput cnorm >&2; printf "\n" >&2; exit 130' INT TERM

    draw() {
        for i in "${!options[@]}"; do
            if [ "$i" -eq "$selected" ]; then
                printf "  \033[1;36m▸ %s\033[0m\n" "${options[$i]}" >&2
            else
                printf "    %s\n" "${options[$i]}" >&2
            fi
        done
    }

    printf "\033[1mSelect commit type\033[0m  \033[2m(↑↓ or j/k, Enter to confirm, Esc to cancel)\033[0m\n" >&2
    draw

    while true; do
        IFS= read -rsn1 key
        case "$key" in
            $'\x1b')
                # Arrow keys send a 3-byte sequence: ESC [ A/B (CSI mode) or
                # ESC O A/B (application/SS3 mode — some terminals use this).
                # Read the prefix and final byte separately. Use an integer
                # timeout — macOS ships bash 3.2, which rejects fractional
                # `-t` values (`read: 0.2: invalid timeout specification`)
                # and silently fails the read, making arrow keys look dead.
                # Buffered bytes return instantly; the timeout only applies
                # to a genuine bare ESC (cancel), so 1s is fine.
                IFS= read -rsn1 -t 1 key2 || key2=""
                if [[ "$key2" == "[" || "$key2" == "O" ]]; then
                    IFS= read -rsn1 -t 1 key3 || key3=""
                    case "$key3" in
                        A) selected=$(( (selected - 1 + count) % count )) ;;
                        B) selected=$(( (selected + 1) % count )) ;;
                    esac
                elif [[ -z "$key2" ]]; then
                    tput cnorm >&2
                    printf "\nCancelled.\n" >&2
                    return 1
                fi
                ;;
            '') break ;;
            k|K) selected=$(( (selected - 1 + count) % count )) ;;
            j|J) selected=$(( (selected + 1) % count )) ;;
        esac

        tput cuu "$count" >&2
        tput ed >&2
        draw
    done

    tput cnorm >&2
    printf '%s\n' "${options[$selected]}" | awk '{print $1}'
}

chosen=$(select_type "${TYPES[@]}") || exit 1
new_subject="$chosen: $subject"

tmpfile=$(mktemp)
awk -v new="$new_subject" '
    BEGIN { done = 0 }
    {
        if (!done && $0 !~ /^#/ && $0 !~ /^[[:space:]]*$/) {
            print new
            done = 1
        } else {
            print
        }
    }
' "$COMMIT_MSG_FILE" > "$tmpfile" && mv "$tmpfile" "$COMMIT_MSG_FILE"

printf "\033[32m✓\033[0m %s\n" "$new_subject" >&2
